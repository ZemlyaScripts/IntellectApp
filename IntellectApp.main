<!DOCTYPE html>
<html lang="ru"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Расписание и ДЗ</title>
<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);--bg:#f5f6fa;--card:#fff;--tx:#1d2030;--mut:#757a8c;--ln:#e3e5ee;--ac:#4f46e5;--ok:#16a34a}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#14151c;--card:#1e2029;--tx:#eceef6;--mut:#9094a8;--ln:#2e3140;--ac:#818cf8;--ok:#4ade80}}
:root[data-theme="dark"]{--bg:#14151c;--card:#1e2029;--tx:#eceef6;--mut:#9094a8;--ln:#2e3140;--ac:#818cf8;--ok:#4ade80}
*{box-sizing:border-box}html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--tx);font:16px/1.4 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;max-width:560px;margin:auto;padding:12px 12px 80px}
.seg{display:flex;gap:6px;overflow-x:auto;margin:8px 0}
.seg button{flex:1;white-space:nowrap;padding:9px 12px;border:1px solid var(--ln);background:var(--card);color:var(--tx);border-radius:10px;font-size:15px}
.seg button.on{background:var(--ac);color:#fff;border-color:var(--ac)}
.tabs{position:sticky;top:env(safe-area-inset-top,0px);background:var(--bg);padding:4px 0;z-index:2}
.card{background:var(--card);border:1px solid var(--ln);border-radius:12px;margin:8px 0;overflow:hidden}
.row{display:flex;align-items:center;gap:10px;padding:12px}
.n{width:26px;height:26px;border-radius:50%;background:var(--bg);color:var(--mut);display:grid;place-items:center;font-size:13px;flex:none}
.n.g{background:var(--ok);color:#fff;font-weight:700}
.s{flex:1;font-weight:600}
.b{background:var(--ac);color:#fff;border-radius:99px;font-size:12px;padding:2px 8px}
.ex{border-top:1px solid var(--ln);padding:8px 12px 12px}
.hw{display:flex;align-items:center;gap:10px;padding:8px 0}
.hw input[type=checkbox]{width:22px;height:22px;accent-color:var(--ok);flex:none}
.hw span{flex:1;word-break:break-word}.hw.d span{text-decoration:line-through;color:var(--mut)}
.x{background:none;border:0;color:var(--mut);font-size:20px;padding:4px 8px}
.add{display:flex;gap:6px;margin-top:6px}
input[type=text],select{flex:1;min-width:0;padding:10px;border:1px solid var(--ln);border-radius:10px;background:var(--bg);color:var(--tx);font-size:16px}
.go{padding:10px 14px;border:0;border-radius:10px;background:var(--ac);color:#fff;font-size:16px}
h3{margin:16px 4px 4px;font-size:14px;color:var(--mut);font-weight:600;text-transform:uppercase}
.e{color:var(--mut);text-align:center;padding:24px}
</style></head><body>
<div class="seg" id="cls"></div>
<div class="tabs"><div class="seg" id="tabs"></div><div class="seg" id="days"></div></div>
<div id="main"></div>
<script>
const CL=["7а (12 лет)","7б (12 лет)","7в","7г"];
const D=[["Пн","Понедельник",["Химия|География|Английский язык|Арабский язык","Английский язык|Химия|Арабский язык|География","География|Арабский язык|Химия|Английский язык","Арабский язык|Английский язык|География|Химия","Кыргыз тил|Информатика|Математика|Русский язык","Русский язык|Кыргыз тил|Информатика|Математика","Математика|Русский язык|Кыргыз тил|Информатика","Информатика|Математика|Русский язык|Кыргыз тил"]],
["Вт","Вторник",["ЧиО|Арабский язык|Биология|Английский язык","Арабский язык|Английский язык|ЧиО|Биология","Английский язык|Биология|Арабский язык|ЧиО","Биология|История|Английский язык|Арабский язык","Физра|Русский язык|Кыргыз адабият|Математика","Русский язык|Физра|Математика|Кыргыз адабият","Кыргыз адабият|Математика|Физра|Русский язык","Математика|Кыргыз адабият|Русский язык|Физра"]],
["Ср","Среда",["Английский язык|Арабский язык|География|Физра","Арабский язык|Английский язык|Физра|География","География|Физра|Арабский язык|Английский язык","Физра|География|Английский язык|Арабский язык","Информатика|Кыргыз тил|Русский язык|Математика","Кыргыз тил|Русский язык|Математика|Информатика","Русский язык|Математика|Информатика|Кыргыз тил","Математика|Информатика|Кыргыз тил|Русский язык"]],
["Чт","Четверг",["Английский язык|Биология|Арабский язык|Английский язык","Биология|Арабский язык|Этюд|Этюд","История|Английский язык|Биология|Арабский язык","Арабский язык|История|Английский язык|Биология","Физика|Литература|История|Развитие рел","Развитие рел|Физика|Литература|Этюд","Литература|Развитие рел|Физика|Литература","Классный час|Этюд|Развитие рел|История"]],
["Пт","Пятница",["Этюд|Английский язык|Арабский язык|История","Английский язык|Арабский язык|История|Английский язык","История|Этюд|Английский язык|Арабский язык","Арабский язык|ЧиО|Классный час|История","Математика|Литература|ЧиО|Физика","ЧиО|Математика|Физика|Литература","Литература|Физика|Математика|ЧиО","Физика|ЧиО|Литература|Математика"]]];
let st={c:0,t:0,d:Math.min(Math.max(new Date().getDay()-1,0),4),hw:[],g:{}},open=-1;
try{const r=localStorage.getItem("hw7");if(r)Object.assign(st,JSON.parse(r))}catch(e){}
function save(){try{localStorage.setItem("hw7",JSON.stringify(st))}catch(e){}}
const $=id=>document.getElementById(id);
const esc=s=>s.replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const subs=()=>[...new Set(D.flatMap(d=>d[2].map(r=>r.split("|")[st.c])))].sort();
function btns(a,cur,fn){return a.map((x,i)=>`<button class="${i===cur?"on":""}" onclick="${fn}(${i})">${x}</button>`).join("")}
function hwHTML(h){return `<div class="hw ${h.done?"d":""}"><input type="checkbox" ${h.done?"checked":""} onchange="tg(${h.id})"><span>${esc(h.text)}</span><button class="x" onclick="rm(${h.id})">×</button></div>`}
function render(){
 $("cls").innerHTML=btns(CL,st.c,"sc");
 $("tabs").innerHTML=btns(["Расписание","Домашка"],st.t,"stab");
 $("days").innerHTML=st.t===0?btns(D.map(d=>d[0]),st.d,"sd"):"";
 $("days").style.display=st.t===0?"flex":"none";
 const m=$("main");
 if(st.t===0){
  m.innerHTML=D[st.d][2].map((r,i)=>{const s=r.split("|")[st.c];
   const l=st.hw.filter(h=>h.c===st.c&&h.s===s),p=l.filter(h=>!h.done).length;
   return `<div class="card"><div class="row" onclick="op(${i})"><div class="n ${st.g[st.c+'-'+st.d+'-'+i]?'g':''}" onclick="event.stopPropagation();gt('${st.c}-${st.d}-${i}')">${i+1}</div><div class="s">${s}</div>${p?`<span class="b">${p}</span>`:""}</div>${l.length||open===i?`<div class="ex">${l.map(hwHTML).join("")}${open===i?`<div class="add"><input type="text" id="q" placeholder="Записать ДЗ по предмету…" onkeydown="if(event.key==='Enter')ad('${s}')"><button class="go" onclick="ad('${s}')">+</button></div>`:""}</div>`:""}</div>`}).join("");
 }else{
  const l=st.hw.filter(h=>h.c===st.c),p=l.filter(h=>!h.done),d=l.filter(h=>h.done);
  m.innerHTML=`<div class="card"><div class="ex" style="border:0"><div class="add" style="margin:0"><select id="ss">${subs().map(s=>`<option>${s}</option>`).join("")}</select></div><div class="add"><input type="text" id="q" placeholder="Что задали?" onkeydown="if(event.key==='Enter')ad2()"><button class="go" onclick="ad2()">+</button></div></div></div>`+
  `<h3>Надо сделать (${p.length})</h3>`+(p.length?p.map(h=>`<div class="card"><div class="ex" style="border:0;padding:4px 12px"><small style="color:var(--ac);font-weight:600">${h.s}</small>${hwHTML(h)}</div></div>`).join(""):'<div class="e">Всё сделано 🎉</div>')+
  (d.length?`<h3>Готово (${d.length})</h3>`+d.map(h=>`<div class="card"><div class="ex" style="border:0;padding:4px 12px"><small style="color:var(--mut)">${h.s}</small>${hwHTML(h)}</div></div>`).join(""):"");
 }
}
function gt(k){st.g[k]=!st.g[k];save();render()}
function sc(i){st.c=i;open=-1;save();render()}
function stab(i){st.t=i;save();render()}
function sd(i){st.d=i;open=-1;save();render()}
function op(i){open=open===i?-1:i;render();const q=$("q");if(q&&open>=0)q.focus()}
function put(s,t){t=t.trim();if(!t)return;st.hw.unshift({id:Date.now(),c:st.c,s,text:t,done:false});save();render()}
function ad(s){put(s,$("q").value)}
function ad2(){put($("ss").value,$("q").value)}
function tg(id){const h=st.hw.find(x=>x.id===id);h.done=!h.done;save();render()}
function rm(id){st.hw=st.hw.filter(x=>x.id!==id);save();render()}
render();
</script></body></html>
